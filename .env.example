# EdgeOne Makers AI Gateway — required for LLM access (names only; never commit real values)
AI_GATEWAY_API_KEY=your_api_key_here
AI_GATEWAY_BASE_URL=https://ai-gateway.edgeone.link/v1

# Model (optional). Default: @makers/deepseek-v4.1-flash
# AI_GATEWAY_MODEL=@makers/deepseek-v4.1-flash

# Optional generic overrides (take precedence over AI_GATEWAY_*)
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Admin token for POST /trends/delete (header x-admin-token). Unset = delete disabled.
# ADMIN_TOKEN=

# Local-dev only: where the file-system fallback stores reports when context.store is absent
# TRENDS_DATA_DIR=data/trends
