{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cloudFunctions": {
    "nodejs": {
      "includeFiles": []
    }
  },
  "agents": {
    "framework": "openai-agents-sdk",
    "timeout": 1200,
    "sandbox": {
      "timeout": 300
    }
  },
  "schedules": [
    {
      "name": "daily-trends",
      "cron": "0 9 * * *",
      "path": "/trends/run",
      "method": "POST",
      "timezone": "Asia/Shanghai",
      "payload": {
        "_schedule": true,
        "trigger": "schedule",
        "sources": ["all"],
        "limit": 30
      }
    },
    {
      "name": "listed-daily",
      "cron": "20 9 * * *",
      "path": "/trends/listed",
      "method": "POST",
      "timezone": "Asia/Shanghai",
      "payload": {
        "_schedule": true,
        "trigger": "schedule",
        "windowDays": 30,
        "maxModelCalls": 20
      }
    },
    {
      "name": "weekly-trends",
      "cron": "0 10 * * 5",
      "path": "/trends/weekly",
      "method": "POST",
      "timezone": "Asia/Shanghai",
      "payload": {
        "_schedule": true,
        "trigger": "schedule",
        "days": 7
      }
    }
  ]
}
